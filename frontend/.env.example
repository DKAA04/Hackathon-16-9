# Main FastAPI backend. The UI falls back to demo data when it is unavailable.
VITE_API_URL=http://localhost:8000

# Local DuckDuckGov enrichment fallback.
VITE_ENRICH_URL=http://127.0.0.1:8765

# auto uses the backend when it has data, otherwise uses the included demo snapshot.
# Valid values: auto | api | demo
VITE_DATA_MODE=auto
VITE_MUNICIPALITY=Schoten
