FRONTEND_ORIGIN=http://localhost:5173

# AI (optional — email drafting / natural-language query)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Google Places API (New) — optional, enrichment degrades gracefully without it
GOOGLE_MAPS_API_KEY=

# SMTP (optional — email sending; drafting works without it)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=S
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=CivicLens

# Nightly import + cleaning + enrichment job (runs inside the backend)
NIGHTLY_ENABLED=true
NIGHTLY_TIME=02:15
NIGHTLY_ENRICH_LIMIT=20

# Later / not implemented yet
# Optional official Google Places API key. Enables Google Maps contact lookup.
GOOGLE_MAPS_API_KEY=
# Optional: use a separate model for only the enrichment web-search fallback.
ENRICH_OPENAI_MODEL=gpt-5-mini
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# every AI call goes to this number, never to the business itself
CALL_TEST_NUMBER=+32489816582
